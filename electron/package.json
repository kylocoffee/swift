{
  "name": "swift-core-banking-desktop",
  "version": "1.0.0",
  "description": "SWIFT Core Banking Enterprise Desktop Terminal (Auto-Updating)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "author": "Bank Nusantara International",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "electron": "30.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.swift.corebanking",
    "productName": "SWIFT Core Banking Terminal",
    "electronVersion": "30.0.0",
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "asInvoker",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "SWIFT_Core_Banking_Terminal_Portable.exe"
    }
  }
}
